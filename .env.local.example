# ═══ Milele — Variables d'environnement ═══

# Malaika — IA conversationnelle (Anthropic Claude)
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mode test libre (capacité maximale pendant la phase d'essai)
# true/false
MALAIKA_TEST_FREE_MODE=false

# Autoriser le fallback mock quand le provider IA est indisponible
# En mode test libre, il est recommandé de laisser false pour voir les vraies limites du modèle
MALAIKA_ALLOW_MOCK_FALLBACK=true

# Paramètres IA (optionnel)
MALAIKA_MODEL=claude-3-5-sonnet-20241022
MALAIKA_MAX_TOKENS=1800
MALAIKA_HISTORY_LIMIT=40
MALAIKA_MAX_MESSAGE_CHARS=6000

# Staff Malaika (optionnel)
MALAIKA_STAFF_MAX_TOKENS=2200
MALAIKA_STAFF_HISTORY_LIMIT=40
MALAIKA_STAFF_MAX_MESSAGE_CHARS=6000

# En test, permet aux non-admin de déclencher les actions de transmission (staff route)
MALAIKA_STAFF_ALLOW_NON_ADMIN_DISPATCH=false

# Supabase (Phase future)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Monark Monitoring (Express / API logs)
MONARK_LOG_SECRET=
MONARK_LOG_ENDPOINT=
MONARK_LOG_BUFFER_SIZE=200
MONARK_LOG_DIR=./logs
MONARK_LOG_FILE=./logs/monark.log
